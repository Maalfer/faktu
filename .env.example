# ── Faktu · configuración por entorno ──────────────────────────────
# Copia este archivo a `.env` y ajusta los valores.

APP_NAME=Faktu
DEBUG=false

# Seguridad: ¡cambia esta clave por una larga y aleatoria!
#   generador: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-en-produccion-por-otra-segura-32b
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Base de datos (por defecto, SQLite local ./faktu.db)
# Ejemplo con Postgres: postgresql+asyncpg://faktu:faktu@localhost:5432/faktu
DATABASE_URL=sqlite+aiosqlite:///./faktu.db

# Crear tablas automáticamente al arrancar (solo desarrollo)
AUTO_CREATE_TABLES=true

# Almacenamiento de archivos de gastos
MEDIA_DIR=./media
MAX_UPLOAD_SIZE=10485760